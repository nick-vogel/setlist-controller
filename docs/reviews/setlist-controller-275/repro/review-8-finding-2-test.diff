+  it("keeps the song after a loop's brace end out of the looping song's meter when Live wraps on it", async () => {
+    const { target, producer } = await checkedRig([], TWO_SONGS);
+    await producer.snapshot(shows(MATCHED));
+    rig!.live.setSignature(6, 8);
+    rig!.live.setLoop({ on: true, start: 16, length: 16 });
+    rig!.live.setPlaying(true);
+    rig!.live.setPosition(31.75);
+    await next(producer, (snapshot) => snapshot.playing && snapshot.position === 31.75);
+    rig!.live.setPosition(32);
+    await next(producer, (snapshot) => snapshot.position === 32);
+    rig!.live.setPosition(16.25);
+    await next(producer, (snapshot) => snapshot.position === 16.25);
+    rig!.live.setPlaying(false);
+    await next(producer, (snapshot) => !snapshot.playing);
+
+    expect(Object.fromEntries(target.meters.at(-1)!)).toEqual({ 1: 3 });
+  });
+
   // Plays into the second song, which Live reports in 6/8, so a meter waits for Live to stop, then
