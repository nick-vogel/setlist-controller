{
  "name": "setlist-controller",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:fake-live": "node src/fake-live/main.ts",
    "dev:server": "node src/server/main.ts --lateness-log dist/dev-cue-lateness.log",
    "dev:web": "vite",
    "lint": "eslint .",
    "check:private": "node scripts/check-private-terms.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "build-set": "node src/set-builder/main.ts",
    "lateness": "node src/lateness/main.ts"
  },
  "dependencies": {
    "@julusian/midi": "3.8.1",
    "@rgrove/parse-xml": "^5.0.0",
    "atem-connection": "3.10.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
